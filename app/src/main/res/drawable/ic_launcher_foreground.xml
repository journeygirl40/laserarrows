<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
        本物の尺玉花火のイメージ(参考写真: 金/白を基調に、細い光条が四方八方へ
        たくさん伸び、青や赤がわずかに混ざる)。下から細い一本の光の尾を引いて
        打ち上がり、頂点で16本の細い光条が放射状に開く。派手な虹色ではなく
        金・白を主体に、青と赤をアクセントとして数本だけ混ぜる。
        アダプティブアイコンは端末によって円/角丸四角にマスクされ108x108の外周は
        切り取られるため、主要な形は安全に見える範囲(中心(54,54)、半径33の円に
        内接する正方形=およそ31〜77)に収める。
    -->
    <!-- 打ち上げの尾:外側の柔らかいグロー -->
    <path
        android:strokeColor="#FFD98A"
        android:strokeAlpha="0.25"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:pathData="M54,74 L54,48" />
    <!-- 打ち上げの尾:芯 -->
    <path
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M54,74 L54,48">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="74" android:endX="54" android:endY="48"
                android:startColor="#FFB347" android:endColor="#FFFFFF" />
        </aapt:attr>
    </path>
    <!-- 尾に沿って散る小さな火の粉 -->
    <path android:fillColor="#FFD98A" android:fillAlpha="0.75" android:pathData="M57,68 m-0.8,0 a0.8,0.8 0 1,0 1.6,0 a0.8,0.8 0 1,0 -1.6,0" />
    <path android:fillColor="#FFD98A" android:fillAlpha="0.6" android:pathData="M51.5,62 m-0.7,0 a0.7,0.7 0 1,0 1.4,0 a0.7,0.7 0 1,0 -1.4,0" />
    <path android:fillColor="#FFFFFF" android:fillAlpha="0.55" android:pathData="M56,56 m-0.6,0 a0.6,0.6 0 1,0 1.2,0 a0.6,0.6 0 1,0 -1.2,0" />

    <!-- 開花点:周囲のやわらかい光暈 -->
    <path android:pathData="M54,48 m-13,0 a13,13 0 1,0 26,0 a13,13 0 1,0 -26,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="48" android:gradientRadius="13"
                android:startColor="#59FFE9B0" android:endColor="#00FFE9B0" />
        </aapt:attr>
    </path>

    <!-- 開花点:放射状に伸びる16本の細い光条(金・白を主体に、青と赤をわずかに) -->
    <path android:strokeLineCap="round" android:strokeWidth="1.7" android:pathData="M60,48 L73,48">
        <aapt:attr name="android:strokeColor"><gradient android:type="linear" android:startX="60" android:startY="48" android:endX="73" android:endY="48" android:startColor="#FF6B7A" android:endColor="#00FF6B7A" /></aapt:attr>
    </path>
    <path android:strokeLineCap="round" android:strokeWidth="1.7" android:pathData="M59.54,50.3 L70.63,54.89">
        <aapt:attr name="android:strokeColor"><gradient android:type="linear" android:startX="59.54" android:startY="50.3" android:endX="70.63" android:endY="54.89" android:startColor="#FFD98A" android:endColor="#00FFD98A" /></aapt:attr>
    </path>
    <path android:strokeLineCap="round" android:strokeWidth="1.7" android:pathData="M58.24,52.24 L68.14,62.14">
        <aapt:attr name="android:strokeColor"><gradient android:type="linear" android:startX="58.24" android:startY="52.24" android:endX="68.14" android:endY="62.14" android:startColor="#FFFFFF" android:endColor="#00FFFFFF" /></aapt:attr>
    </path>
    <path android:strokeLineCap="round" android:strokeWidth="1.7" android:pathData="M56.3,53.54 L60.51,63.71">
        <aapt:attr name="android:strokeColor"><gradient android:type="linear" android:startX="56.3" android:startY="53.54" android:endX="60.51" android:endY="63.71" android:startColor="#FFD98A" android:endColor="#00FFD98A" /></aapt:attr>
    </path>
    <path android:strokeLineCap="round" android:strokeWidth="1.7" android:pathData="M54,54 L54,67">
        <aapt:attr name="android:strokeColor"><gradient android:type="linear" android:startX="54" android:startY="54" android:endX="54" android:endY="67" android:startColor="#6FC6FF" android:endColor="#006FC6FF" /></aapt:attr>
    </path>
    <path android:strokeLineCap="round" android:strokeWidth="1.7" android:pathData="M51.7,53.54 L47.11,64.63">
        <aapt:attr name="android:strokeColor"><gradient android:type="linear" android:startX="51.7" android:startY="53.54" android:endX="47.11" android:endY="64.63" android:startColor="#FFFFFF" android:endColor="#00FFFFFF" /></aapt:attr>
    </path>
    <path android:strokeLineCap="round" android:strokeWidth="1.7" android:pathData="M49.76,52.24 L39.86,62.14">
        <aapt:attr name="android:strokeColor"><gradient android:type="linear" android:startX="49.76" android:startY="52.24" android:endX="39.86" android:endY="62.14" android:startColor="#FFD98A" android:endColor="#00FFD98A" /></aapt:attr>
    </path>
    <path android:strokeLineCap="round" android:strokeWidth="1.7" android:pathData="M48.46,50.3 L38.29,54.51">
        <aapt:attr name="android:strokeColor"><gradient android:type="linear" android:startX="48.46" android:startY="50.3" android:endX="38.29" android:endY="54.51" android:startColor="#FFFFFF" android:endColor="#00FFFFFF" /></aapt:attr>
    </path>
    <path android:strokeLineCap="round" android:strokeWidth="1.7" android:pathData="M48,48 L35,48">
        <aapt:attr name="android:strokeColor"><gradient android:type="linear" android:startX="48" android:startY="48" android:endX="35" android:endY="48" android:startColor="#FF6B7A" android:endColor="#00FF6B7A" /></aapt:attr>
    </path>
    <path android:strokeLineCap="round" android:strokeWidth="1.7" android:pathData="M48.46,45.7 L37.37,41.11">
        <aapt:attr name="android:strokeColor"><gradient android:type="linear" android:startX="48.46" android:startY="45.7" android:endX="37.37" android:endY="41.11" android:startColor="#FFD98A" android:endColor="#00FFD98A" /></aapt:attr>
    </path>
    <path android:strokeLineCap="round" android:strokeWidth="1.7" android:pathData="M49.76,43.76 L39.86,33.86">
        <aapt:attr name="android:strokeColor"><gradient android:type="linear" android:startX="49.76" android:startY="43.76" android:endX="39.86" android:endY="33.86" android:startColor="#FFFFFF" android:endColor="#00FFFFFF" /></aapt:attr>
    </path>
    <path android:strokeLineCap="round" android:strokeWidth="1.7" android:pathData="M51.7,42.46 L47.87,33.22">
        <aapt:attr name="android:strokeColor"><gradient android:type="linear" android:startX="51.7" android:startY="42.46" android:endX="47.87" android:endY="33.22" android:startColor="#FFD98A" android:endColor="#00FFD98A" /></aapt:attr>
    </path>
    <path android:strokeLineCap="round" android:strokeWidth="1.7" android:pathData="M54,42 L54,35">
        <aapt:attr name="android:strokeColor"><gradient android:type="linear" android:startX="54" android:startY="42" android:endX="54" android:endY="35" android:startColor="#6FC6FF" android:endColor="#006FC6FF" /></aapt:attr>
    </path>
    <path android:strokeLineCap="round" android:strokeWidth="1.7" android:pathData="M56.3,42.46 L60.13,33.22">
        <aapt:attr name="android:strokeColor"><gradient android:type="linear" android:startX="56.3" android:startY="42.46" android:endX="60.13" android:endY="33.22" android:startColor="#FFFFFF" android:endColor="#00FFFFFF" /></aapt:attr>
    </path>
    <path android:strokeLineCap="round" android:strokeWidth="1.7" android:pathData="M58.24,43.76 L67.44,34.56">
        <aapt:attr name="android:strokeColor"><gradient android:type="linear" android:startX="58.24" android:startY="43.76" android:endX="67.44" android:endY="34.56" android:startColor="#FFD98A" android:endColor="#00FFD98A" /></aapt:attr>
    </path>
    <path android:strokeLineCap="round" android:strokeWidth="1.7" android:pathData="M59.54,45.7 L70.63,41.11">
        <aapt:attr name="android:strokeColor"><gradient android:type="linear" android:startX="59.54" android:startY="45.7" android:endX="70.63" android:endY="41.11" android:startColor="#FFFFFF" android:endColor="#00FFFFFF" /></aapt:attr>
    </path>

    <!-- 開花点:先端の小さな火花(金の光条のみ、控えめに) -->
    <path android:fillColor="#FFD98A" android:pathData="M70.63,54.89 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0" />
    <path android:fillColor="#FFD98A" android:pathData="M60.51,63.71 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0" />
    <path android:fillColor="#FFD98A" android:pathData="M39.86,62.14 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0" />
    <path android:fillColor="#FFD98A" android:pathData="M37.37,41.11 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0" />
    <path android:fillColor="#FFD98A" android:pathData="M47.87,33.22 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0" />
    <path android:fillColor="#FFD98A" android:pathData="M67.44,34.56 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0" />

    <!-- 開花点:中心の発光コア(白→金) -->
    <path android:pathData="M54,48 m-4.4,0 a4.4,4.4 0 1,0 8.8,0 a4.4,4.4 0 1,0 -8.8,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="48" android:gradientRadius="4.4"
                android:startColor="#FFFFFFFF" android:endColor="#FFD98A" />
        </aapt:attr>
    </path>
    <!-- 開花点:艶のハイライト -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.9"
        android:pathData="M52.6,46.6 m-1.2,0 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0" />
</vector>
