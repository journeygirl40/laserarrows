<?xml version="1.0" encoding="utf-8"?>
<!--
  アプリアイコンの前景: 3Dのキツネと、その上で輝くハート(ゲームの「出会い」を一目で伝える)。
  位置は108dp座標を割合(%)に直して指定する。dp固定だと、起動画面のように大きく描かれた時に
  キツネが左上に小さく寄ってしまうため、どの大きさで描かれても同じ配置になるようにしている。
  (キツネ: 左30 上34 大きさ48 / ハート: 左42 上19 大きさ24。いずれも安全範囲の中央66dpに収まる)
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <inset
            android:drawable="@drawable/animal_fox"
            android:insetLeft="27.78%"
            android:insetTop="31.48%"
            android:insetRight="27.78%"
            android:insetBottom="24.07%" />
    </item>
    <item>
        <inset
            android:drawable="@drawable/icon_sparkling_heart"
            android:insetLeft="38.89%"
            android:insetTop="17.59%"
            android:insetRight="38.89%"
            android:insetBottom="60.19%" />
    </item>
</layer-list>
